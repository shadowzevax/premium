diff --git a/mods/features/backToPip.js b/mods/features/backToPip.js
new file mode 100644
index 0000000..d663cbd
--- /dev/null
+++ b/mods/features/backToPip.js
@@ -0,0 +1,56 @@
+// Back button -> keep playing in background (Picture in Picture or hidden).
+// Reuses the official enablePip(), which already performs "HISTORY_BACK + keep video".
+
+import { configRead } from '../config.js';
+import { enablePip } from './pictureInPicture.js';
+import { showToast } from '../ui/ytUI.js';
+
+const BACK_KEYS = [27, 8, 461, 10009];
+
+function isWatchingFullscreen() {
+    const player = document.querySelector('ytlr-player');
+    const video = document.querySelector('video');
+    if (!player || !video || window.isPipPlaying) return false;
+    if (!player.classList.contains('ytLrPlayerEnabled')) return false;
+    if (video.paused || video.ended) return false;
+    // Leave menus/popups (quality, speed, TizenTube modals...) to the normal back behaviour.
+    if (document.querySelector('ytlr-overlay-panel, ytlr-popup-panel, .tt-modal, [id^="tt-"][id$="-modal"]')) return false;
+    return true;
+}
+
+function applyHiddenMode() {
+    const video = document.querySelector('video');
+    if (!video) return;
+    video.style.opacity = '0';
+    video.style.width = '1px';
+    video.style.height = '1px';
+}
+
+function waitForPipThen(cb, tries = 0) {
+    if (window.isPipPlaying) return cb();
+    if (tries > 40) return;
+    setTimeout(() => waitForPipThen(cb, tries + 1), 100);
+}
+
+document.addEventListener('keydown', (evt) => {
+    if (!BACK_KEYS.includes(evt.keyCode)) return;
+    if (!configRead('enableBackgroundOnBack')) return;
+    if (!isWatchingFullscreen()) return;
+
+    evt.preventDefault();
+    evt.stopImmediatePropagation();
+
+    enablePip();
+
+    waitForPipThen(() => {
+        if (!configRead('backgroundShowPipWindow')) applyHiddenMode();
+        if (configRead('backgroundShowToast')) {
+            showToast(
+                'TizenTube',
+                configRead('backgroundShowPipWindow')
+                    ? 'Video en ventana pequeña. Usa el botón junto a la búsqueda para volver.'
+                    : 'Video en segundo plano. Usa el botón junto a la búsqueda para volver.'
+            );
+        }
+    });
+}, true);
