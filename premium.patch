diff --git a/mods/features/videoWatchdog.js b/mods/features/videoWatchdog.js
new file mode 100644
index 0000000..d62bda0
--- /dev/null
+++ b/mods/features/videoWatchdog.js
@@ -0,0 +1,45 @@
+// Rixius video watchdog: on some TV boxes the picture freezes/goes black while audio keeps
+// playing (upstream TizenTubeCobalt #320/#397). Detect it and reload the video at the same
+// second, which re-creates the decoder/surface — no need to force-stop the app.
+
+import { showToast } from '../ui/ytUI.js';
+
+const CHECK_MS = 1000;
+const STALL_CHECKS = 4;          // ~4s with time advancing but no new frames
+let lastFrames = -1, lastTime = -1, stalled = 0, framesWorked = false, cooldownUntil = 0;
+
+function frames(video) {
+    try {
+        const q = video.getVideoPlaybackQuality && video.getVideoPlaybackQuality();
+        if (q && typeof q.totalVideoFrames === 'number') return q.totalVideoFrames;
+    } catch (_) { }
+    return typeof video.webkitDecodedFrameCount === 'number' ? video.webkitDecodedFrameCount : -1;
+}
+
+function reloadVideo(video) {
+    const mappings = Object.values(window._yttv || {}).find(a => a && a.mappings);
+    const ps = mappings && mappings.get('PlayerService');
+    if (!ps || !ps.loadedPlaybackConfig) return;
+    ps.loadedPlaybackConfig.watchEndpoint.startTimeSeconds = Math.floor(video.currentTime);
+    ps.loadVideo(ps.loadedPlaybackConfig);
+    showToast('Rixius', 'Imagen recuperada');
+}
+
+setInterval(() => {
+    const video = document.querySelector('video');
+    if (!video || video.paused || video.ended || video.readyState < 2 || window.isPipPlaying) {
+        stalled = 0; lastFrames = -1; return;
+    }
+    const f = frames(video), t = video.currentTime;
+    if (f < 0) return;                                   // API not available: do nothing
+    if (lastFrames >= 0 && f > lastFrames) framesWorked = true;
+    const timeAdvanced = lastTime >= 0 && t > lastTime + 0.5;
+    if (framesWorked && timeAdvanced && f === lastFrames) stalled++;
+    else stalled = 0;
+    lastFrames = f; lastTime = t;
+
+    if (stalled >= STALL_CHECKS && Date.now() > cooldownUntil) {
+        stalled = 0; framesWorked = false; cooldownUntil = Date.now() + 20000;
+        reloadVideo(video);
+    }
+}, CHECK_MS);
