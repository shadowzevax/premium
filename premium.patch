diff --git a/mods/features/backToPip.js b/mods/features/backToPip.js
new file mode 100644
index 0000000..a35357c
--- /dev/null
+++ b/mods/features/backToPip.js
@@ -0,0 +1,216 @@
+// Back button -> same as the official "Mini Player" button (enablePip): YouTube goes back, the
+// video keeps playing and a "return to video" button appears next to Search.
+// Optional: hide the corner video (audio only). Shows the playing title as a scrolling marquee.
+
+import { configRead } from '../config.js';
+import { enablePip } from './pictureInPicture.js';
+import { showToast } from '../ui/ytUI.js';
+
+// 166 = BrowserBack (Android remote Back in Chromium/Cobalt), 27 = Escape, 8 = Backspace,
+// 461 / 10009 = Back on LG / Tizen remotes.
+const BACK_KEYS = [166, 27, 8, 4, 461, 10009, 65385, 196];
+const BACK_NAMES = ['Escape', 'Esc', 'Backspace', 'GoBack', 'BrowserBack', 'Back', 'XF86Back'];
+const isBack = (evt) => BACK_KEYS.includes(evt.keyCode) || BACK_NAMES.includes(evt.key);
+let swallowKeyUp = false;
+let nowPlayingTitle = '';
+
+function watching() {
+    // Simple and robust: a video is actually playing (previews are disabled, so a playing
+    // video means the player is open) and we're not already in mini player.
+    const video = document.querySelector('video');
+    return !!(video && !window.isPipPlaying && !video.paused && !video.ended && video.currentTime > 0);
+}
+
+function readTitle() {
+    const player = document.querySelector('ytlr-player');
+    if (!player) return '';
+    const candidates = player.querySelectorAll('[class*="itle"], [class*="Title"]');
+    for (const el of candidates) {
+        const text = (el.textContent || '').trim();
+        if (text.length > 3 && text.length < 200) return text;
+    }
+    return '';
+}
+
+// ---- Autoplay while in background: ask YouTube for "up next" and play it when the video ends.
+let upNext = null;          // { watchEndpoint, title }
+let upNextFor = null;       // videoId the upNext belongs to
+
+function services() {
+    const mappings = Object.values(window._yttv || {}).find(a => a && a.mappings);
+    return mappings ? {
+        ps: mappings.get('PlayerService'),
+        ids: mappings.get('CurrentIdentityService'),
+        client: mappings.get('KabukiInnerTubeClient')
+    } : {};
+}
+
+function textOf(t) {
+    if (!t) return '';
+    if (t.simpleText) return t.simpleText;
+    return (t.runs || []).map(r => r.text).join('');
+}
+
+function fetchNext(videoId, cb) {
+    const { ids, client } = services();
+    if (!ids || !client || !videoId) return;
+    ids.get().then(identity => {
+        client.fetch({
+            identity, isPrefetch: false, path: '/youtubei/v1/next',
+            payload: { videoId, racyCheckOk: true, contentCheckOk: true, autonavState: 'STATE_ON' },
+            clickTracking: { clickTrackingParams: null }
+        }).subscribe(response => {
+            const results = response?.contents?.singleColumnWatchNextResults;
+            const set = results?.autoplay?.autoplay?.sets?.[0];
+            const next = set?.autoplayVideo || set?.nextVideoRenderer?.maybeHistoryEndpointRenderer?.endpoint;
+            const section = results?.results?.results?.contents?.find(i => i.itemSectionRenderer);
+            const meta = section?.itemSectionRenderer?.contents?.find(i => i.videoMetadataRenderer)?.videoMetadataRenderer;
+            cb({ title: textOf(meta?.title), next: next?.watchEndpoint ? next : null });
+        });
+    }).catch(() => { });
+}
+
+function currentVideoId() {
+    const { ps } = services();
+    return ps?.loadedPlaybackConfig?.watchEndpoint?.videoId;
+}
+
+function prepareUpNext() {
+    const id = currentVideoId();
+    if (!id || upNextFor === id) return;
+    upNextFor = id;
+    upNext = null;
+    fetchNext(id, info => {
+        if (info.title) nowPlayingTitle = info.title;
+        upNext = info.next;
+    });
+}
+
+function hideIfNeeded() {
+    const video = document.querySelector('video');
+    if (video && !configRead('backgroundShowPipWindow')) {
+        video.style.opacity = '0';
+        video.style.width = '1px';
+        video.style.height = '1px';
+    }
+}
+
+function playUpNext() {
+    if (!window.isPipPlaying || !upNext) return;
+    if (window.queuedVideos && window.queuedVideos.videos && window.queuedVideos.videos.length) return; // user queue wins
+    const { ps } = services();
+    if (!ps || !ps.loadedPlaybackConfig) return;
+    const cfg = Object.assign({}, ps.loadedPlaybackConfig);
+    cfg.watchEndpoint = Object.assign({}, upNext.watchEndpoint, { startTimeSeconds: 0 });
+    if (upNext.clickTrackingParams) cfg.clickTrackingParams = upNext.clickTrackingParams;
+    upNext = null;
+    nowPlayingTitle = '';
+    ps.loadVideo(cfg);
+    setTimeout(() => { hideIfNeeded(); prepareUpNext(); }, 1500);
+}
+
+function attachEndedHandler() {
+    const video = document.querySelector('video');
+    if (!video || video.__rixiusEnded) return;
+    video.__rixiusEnded = true;
+    video.addEventListener('ended', playUpNext);
+}
+
+function block(evt) {
+    evt.preventDefault();
+    evt.stopPropagation();
+    evt.stopImmediatePropagation();
+}
+
+// TEMPORARY diagnostics: show which key arrives (not for arrows/OK/media keys).
+const QUIET_KEYS = [37, 38, 39, 40, 13, 32, 179, 415, 19, 412, 417];
+let lastDiag = 0;
+function diag(evt) {
+    if (!configRead('enableBackgroundOnBack') || QUIET_KEYS.includes(evt.keyCode)) return;
+    if (Date.now() - lastDiag < 800) return;
+    lastDiag = Date.now();
+    showToast('Rixius · diagnóstico', `Tecla ${evt.keyCode} "${evt.key}" · video sonando: ${watching() ? 'sí' : 'no'} · atrás: ${isBack(evt) ? 'sí' : 'no'}`);
+}
+
+function onBack(evt) {
+    if (evt.type === 'keydown') diag(evt);
+    if (!isBack(evt) || !configRead('enableBackgroundOnBack')) return;
+    if (swallowKeyUp) return block(evt);       // auto-repeat while held
+    if (!watching()) return;
+    block(evt);
+    swallowKeyUp = true;
+    nowPlayingTitle = readTitle();
+    enablePip();                               // exactly what the Mini Player button does
+    afterPip();
+}
+
+function onBackUp(evt) {
+    if (!swallowKeyUp || !isBack(evt)) return;
+    swallowKeyUp = false;
+    block(evt);
+}
+
+// Register on window AND document, capture phase, as early as possible.
+window.addEventListener('keydown', onBack, true);
+window.addEventListener('keyup', onBackUp, true);
+
+function afterPip(tries = 0) {
+    if (!window.isPipPlaying) {
+        if (tries < 60) setTimeout(() => afterPip(tries + 1), 100);
+        return;
+    }
+    const video = document.querySelector('video');
+    hideIfNeeded();
+    attachEndedHandler();
+    prepareUpNext();
+    if (configRead('backgroundShowToast')) {
+        showToast('Rixius', configRead('backgroundShowPipWindow')
+            ? 'Video en ventana pequeña. Usa el botón junto a Buscar para volver.'
+            : 'Reproduciendo en segundo plano. Usa el botón junto a Buscar para volver.');
+    }
+}
+
+// Marquee with the playing title next to the "return to video" button.
+const MARQUEE_ID = 'rixius-now-playing';
+const style = document.createElement('style');
+style.textContent = `
+#${MARQUEE_ID}{position:absolute;top:50%;transform:translateY(-50%);left:13.5em;width:16em;
+  overflow:hidden;white-space:nowrap;color:#fff;font-size:1.1em;opacity:.9;pointer-events:none;
+  -webkit-mask-image:linear-gradient(90deg,transparent 0,#000 6%,#000 94%,transparent 100%);}
+#${MARQUEE_ID} span{display:inline-block;padding-left:100%;animation:rixius-marquee 14s linear infinite;}
+@keyframes rixius-marquee{from{transform:translateX(0)}to{transform:translateX(-100%)}}`;
+(document.head || document.documentElement).appendChild(style);
+
+setInterval(() => {
+    const existing = document.getElementById(MARQUEE_ID);
+    const pipButton = document.getElementById('tt-pip-button');
+    if (!window.isPipPlaying || !pipButton) {
+        if (existing) existing.remove();
+        // Returning to fullscreen: undo the hidden-mode styles.
+        const video = document.querySelector('video');
+        if (!window.isPipPlaying && video && video.style.opacity === '0') {
+            video.style.removeProperty('opacity');
+            video.style.removeProperty('width');
+            video.style.removeProperty('height');
+        }
+        return;
+    }
+    attachEndedHandler();
+    prepareUpNext();
+    if (!nowPlayingTitle) nowPlayingTitle = readTitle() || 'Reproduciendo';
+    if (existing && existing.dataset.title === nowPlayingTitle) return;
+    if (existing) existing.remove();
+    const box = document.createElement('div');
+    box.id = MARQUEE_ID;
+    box.dataset.title = nowPlayingTitle;
+    const span = document.createElement('span');
+    span.textContent = '♪ ' + nowPlayingTitle;
+    box.appendChild(span);
+    pipButton.parentElement.appendChild(box);
+}, 1000);
+
+// Same marquee also when the official Mini Player button is used.
+// (only on OK/Enter, so normal navigation keys cost nothing)
+document.addEventListener('keydown', (evt) => {
+    if (evt.keyCode === 13 && watching()) nowPlayingTitle = readTitle();
+}, true);
diff --git a/mods/features/fastMode.js b/mods/features/fastMode.js
new file mode 100644
index 0000000..8f23443
--- /dev/null
+++ b/mods/features/fastMode.js
@@ -0,0 +1,42 @@
+// Rixius fast mode: make remote navigation feel instant on low-end TV boxes.
+// - shortens UI transitions to 80ms (animations stay visible but no longer delay the remote)
+// - one-time default: no video previews on focused thumbnails (heavy on TV boxes)
+// Must be imported before features that read those settings at startup.
+
+import { configRead, configWrite, configChangeEmitter } from '../config.js';
+
+if (!configRead('rixiusPerfMigrated')) {
+    configWrite('enablePreviews', false);
+    configWrite('rixiusPerfMigrated', true);
+}
+if (!configRead('rixiusCodecMigrated')) {
+    if (configRead('preferredVideoCodec') === 'any') configWrite('preferredVideoCodec', 'vp9');
+    configWrite('rixiusCodecMigrated', true);
+}
+
+const STYLE_ID = 'rixius-fast-mode';
+const CSS = `
+*, *::before, *::after {
+  transition-duration: 80ms !important; /* still visible, but never makes the remote wait */
+  transition-delay: 0s !important;
+  scroll-behavior: auto !important;
+}`;
+
+function apply() {
+    let el = document.getElementById(STYLE_ID);
+    if (configRead('rixiusFastMode')) {
+        if (!el) {
+            el = document.createElement('style');
+            el.id = STYLE_ID;
+            el.textContent = CSS;
+            (document.head || document.documentElement).appendChild(el);
+        }
+    } else if (el) {
+        el.remove();
+    }
+}
+
+apply();
+configChangeEmitter.addEventListener('configChange', (e) => {
+    if (e.detail.key === 'rixiusFastMode') apply();
+});
diff --git a/mods/features/rixiusUpdater.js b/mods/features/rixiusUpdater.js
new file mode 100644
index 0000000..15d9d69
--- /dev/null
+++ b/mods/features/rixiusUpdater.js
@@ -0,0 +1,89 @@
+// Rixius updater: checks the published build and applies it by restarting the app UI.
+// The engine (APK) rarely changes; the script (ad block, features) is what updates.
+
+import { buttonItem, showModal, showToast, overlayPanelItemListRenderer, overlayMessageRenderer } from '../ui/ytUI.js';
+import { storeBundle } from './selfUpdate.js';
+
+const SCRIPT_URL = 'https://cdn.jsdelivr.net/gh/shadowzevax/premium@main/userScript.js';
+// The engine only allows cdn.jsdelivr.net (raw.githubusercontent / GitHub Pages are blocked).
+// The workflow purges this file on every publish; no-store skips the local cache.
+const VERSION_URL = 'https://cdn.jsdelivr.net/gh/shadowzevax/premium@main/rixius/dist/v1/version.json';
+export const RIXIUS_BUILD = '__RIXIUS_BUILD__';
+
+function fetchLatest() {
+    return fetch(VERSION_URL + '?t=' + Date.now(), { cache: 'no-store' }).then(r => {
+        if (!r.ok) throw new Error('HTTP ' + r.status);
+        return r.json();
+    });
+}
+
+const ATTEMPT_KEY = 'rixius.updateAttempt';
+
+function lastAttempt() {
+    try { return JSON.parse(localStorage[ATTEMPT_KEY] || 'null'); } catch (_) { return null; }
+}
+
+function applyUpdate(latest) {
+    showToast('Rixius', 'Actualizando...');
+    // Preferred: download the exact build from its immutable commit-pinned URL (never stale)
+    // and keep it locally; selfUpdate.js runs it on the next start.
+    if (latest && latest.url) {
+        fetch(latest.url, { cache: 'no-store' })
+            .then(r => { if (!r.ok) throw new Error('HTTP ' + r.status); return r.text(); })
+            .then(code => {
+                if (code.indexOf(latest.build) === -1) throw new Error('build mismatch');
+                if (!storeBundle(latest.build, latest.date, code)) throw new Error('storage');
+                location.reload();
+            })
+            .catch(() => showToast('Rixius', 'No se pudo descargar la actualización. Intenta de nuevo.'));
+        return;
+    }
+    const build = latest && latest.build;
+    try { localStorage[ATTEMPT_KEY] = JSON.stringify({ build, at: Date.now() }); } catch (_) { }
+    // The engine loads the script with its own URL (+ ?v=...), which the browser caches for days.
+    // Re-download every URL it may use with cache:'reload' so the HTTP cache holds the new build,
+    // then restart the web app.
+    const urls = new Set([SCRIPT_URL]);
+    document.querySelectorAll('script[src*="userScript.js"]').forEach(s => urls.add(s.src));
+    Promise.all([...urls].map(u => fetch(u, { cache: 'reload' }).catch(() => {})))
+        .then(() => location.reload());
+}
+
+export function checkForUpdates(manual) {
+    if (manual) showToast('Rixius', 'Buscando actualizaciones...');
+    fetchLatest().then(latest => {
+        if (!latest.build || latest.build === RIXIUS_BUILD) {
+            if (manual) showToast('Rixius', 'Ya tienes la última versión');
+            return;
+        }
+        // Already tried this build recently but the CDN still served the old script:
+        // don't loop; it propagates on its own within minutes/hours.
+        const prev = latest.url ? null : lastAttempt();
+        if (prev && prev.build === latest.build && Date.now() - prev.at < 2 * 3600 * 1000) {
+            if (manual) showToast('Rixius', 'Actualización en camino. Vuelve a intentar en unos minutos.');
+            if (!manual) return;
+            if (Date.now() - prev.at < 10 * 60 * 1000) return;
+        }
+        window.__rixiusPendingBuild = latest;
+        const date = latest.date ? new Date(latest.date).toLocaleString() : '';
+        showModal(
+            { title: 'Actualización disponible', subtitle: date ? 'Publicada: ' + date : '' },
+            overlayPanelItemListRenderer([
+                buttonItem({ title: 'Actualizar ahora', subtitle: 'La app se reinicia en unos segundos' }, { icon: 'DOWN_ARROW' },
+                    [{ customAction: { action: 'RIXIUS_UPDATE_NOW' } }, { signalAction: { signal: 'POPUP_BACK' } }]),
+                buttonItem({ title: 'Más tarde' }, { icon: 'SEARCH_HISTORY' },
+                    [{ signalAction: { signal: 'POPUP_BACK' } }]),
+                overlayMessageRenderer(' ')
+            ]),
+            'rixius-update-modal',
+            false
+        );
+    }).catch(() => {
+        if (manual) showToast('Rixius', 'No se pudo comprobar. Revisa tu conexión.');
+    });
+}
+
+window.__rixiusApplyUpdate = () => applyUpdate(window.__rixiusPendingBuild);
+
+// Automatic check shortly after startup.
+setTimeout(() => checkForUpdates(false), 4000);
diff --git a/mods/features/selfUpdate.js b/mods/features/selfUpdate.js
new file mode 100644
index 0000000..e37f53e
--- /dev/null
+++ b/mods/features/selfUpdate.js
@@ -0,0 +1,38 @@
+// Rixius self-update bootstrap. MUST be the first import of userScript.js.
+// The APK always loads ".../premium@main/userScript.js", which jsDelivr may keep stale for hours.
+// The in-app updater downloads newer builds from immutable commit-pinned URLs and stores them
+// here; on startup, if the stored build is newer than this one, run it instead and stop this one.
+
+const STORE_KEY = 'rixius.bundle';
+const OWN_DATE = '__RIXIUS_BUILD_DATE__';
+
+let stored = null;
+try { stored = JSON.parse(localStorage[STORE_KEY] || 'null'); } catch (_) { stored = null; }
+
+if (stored && stored.code && stored.date && OWN_DATE !== 'dev' && stored.date > OWN_DATE && !window.__rixiusBooted) {
+    window.__rixiusBooted = true;
+    let ok = false;
+    try {
+        (0, eval)(stored.code);
+        ok = true;
+    } catch (e) {
+        try { delete localStorage[STORE_KEY]; } catch (_) { }
+    }
+    if (ok) {
+        // Abort the rest of this (older) bundle.
+        throw new Error('Rixius: running stored build ' + stored.build);
+    }
+} else if (stored && stored.date && OWN_DATE !== 'dev' && stored.date < OWN_DATE) {
+    // The CDN caught up: the stored copy is no longer needed.
+    try { delete localStorage[STORE_KEY]; } catch (_) { }
+}
+window.__rixiusBooted = true;
+
+export function storeBundle(build, date, code) {
+    try {
+        localStorage[STORE_KEY] = JSON.stringify({ build, date, code });
+        return true;
+    } catch (_) {
+        return false;
+    }
+}
diff --git a/mods/features/settingsApplyFix.js b/mods/features/settingsApplyFix.js
new file mode 100644
index 0000000..3661b03
--- /dev/null
+++ b/mods/features/settingsApplyFix.js
@@ -0,0 +1,61 @@
+// Fix "audio but black video" after changing settings while a video is open.
+// When settings change and the player becomes visible again, reload the current video at the
+// same position (re-creates the video surface). Much faster than restarting the app.
+
+import { configChangeEmitter } from '../config.js';
+import { showToast, showModal, buttonItem, overlayPanelItemListRenderer } from '../ui/ytUI.js';
+
+const RESTART_KEYS = ['enableFixedUI', 'enableClock', 'enablePatchingVideoPlayer', 'focusContainerColor', 'routeColor', 'enableScreenDimming'];
+let restartPromptTimer = null;
+configChangeEmitter.addEventListener('configChange', (e) => {
+    if (!RESTART_KEYS.includes(e.detail.key)) return;
+    clearTimeout(restartPromptTimer);
+    restartPromptTimer = setTimeout(() => showModal(
+        { title: 'Reinicio necesario', subtitle: 'Este cambio se aplica al reiniciar la app' },
+        overlayPanelItemListRenderer([
+            buttonItem({ title: 'Reiniciar ahora' }, { icon: 'REFRESH' }, [{ customAction: { action: 'RIXIUS_RESTART' } }]),
+            buttonItem({ title: 'Más tarde' }, { icon: 'SEARCH_HISTORY' }, [{ signalAction: { signal: 'POPUP_BACK' } }])
+        ]),
+        'rixius-restart-modal',
+        false
+    ), 800);
+});
+
+let dirty = false;
+configChangeEmitter.addEventListener('configChange', () => {
+    // Only matters if a video is currently loaded (settings opened from/over the player).
+    const v = document.querySelector('video');
+    if (v && v.currentTime > 0 && !v.ended) dirty = true;
+});
+
+function getPlayerService() {
+    const mappings = Object.values(window._yttv || {}).find(a => a && a.mappings);
+    return mappings ? mappings.get('PlayerService') : null;
+}
+
+function reloadCurrentVideo() {
+    const ps = getPlayerService();
+    const video = document.querySelector('video');
+    if (!ps || !ps.loadedPlaybackConfig || !video || window.isPipPlaying) return;
+    ps.loadedPlaybackConfig.watchEndpoint.startTimeSeconds = Math.floor(video.currentTime);
+    ps.loadVideo(ps.loadedPlaybackConfig);
+    showToast('Rixius', 'Ajustes aplicados');
+}
+
+function watchPlayer() {
+    const player = document.querySelector('ytlr-player');
+    if (!player) return setTimeout(watchPlayer, 1000);
+    let wasEnabled = player.classList.contains('ytLrPlayerEnabled');
+    new MutationObserver(() => {
+        const enabled = player.classList.contains('ytLrPlayerEnabled');
+        if (enabled && !wasEnabled && dirty) {
+            dirty = false;
+            setTimeout(reloadCurrentVideo, 300);
+        }
+        if (!enabled) return (wasEnabled = false);
+        wasEnabled = true;
+    }).observe(player, { attributes: true, attributeFilter: ['class'] });
+}
+
+if (document.readyState === 'complete') watchPlayer();
+else window.addEventListener('load', watchPlayer);
